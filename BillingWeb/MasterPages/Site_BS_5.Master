<%@ Master Language="C#" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KTA Billing</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body{background:#f5f7fa}.page-wrap{max-width:1500px;margin:0 auto;padding:20px}
        .toolbar{background:#fff;border:1px solid #dee2e6;border-radius:.5rem;padding:.5rem;margin-bottom:1rem}
        .toolbar .btn{margin-right:.25rem}.status-box{min-height:42px}
        .table th{white-space:nowrap}
    </style>
</head>
<body>
<form id="form1" runat="server">
<div class="page-wrap">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-0">KTA Billing</h3>
            <div class="text-muted small">Web Billing Process</div>
        </div>
        <asp:Literal ID="litTitle" runat="server" />
    </div>
    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
</div>
</form>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>