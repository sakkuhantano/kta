<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="KTA" connectionString="Data Source=.;Initial Catalog=KTA;Integrated Security=True;Application Name=KTA Billing Web" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Set these to the actual KTA session key names when copied into the production solution. -->
    <add key="KTA.CompanyIDSessionKey" value="CompanyID" />
    <add key="KTA.LocationIDSessionKey" value="LocationID" />
    <add key="KTA.UserIDSessionKey" value="UserID" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" maxRequestLength="51200" executionTimeout="3600" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
</configuration>